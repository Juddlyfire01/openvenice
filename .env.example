# X (Twitter) OAuth 2.0 — Profile tab (connect your own account)
# Create an app at https://developer.x.com → User authentication settings:
#   - Type of App: Web App (confidential) or Native/SPA (public, PKCE only)
#   - App permissions: Read
#   - Callback URI / Redirect URL: must match X_REDIRECT_URI below exactly
#   - Website URL: your app origin
#
# Set these in Vercel → Project → Settings → Environment Variables (and in a
# local .env for `vercel dev`).

# OAuth 2.0 Client ID from the X developer portal
X_CLIENT_ID=

# OAuth 2.0 Client Secret. REQUIRED for a confidential ("Web App") client.
# Leave BLANK for a public client (PKCE-only, no secret).
X_CLIENT_SECRET=

# Must exactly match a Callback URI registered on the X app.
# Local (vercel dev):  http://localhost:3000/api/x/oauth/callback
# Production:          https://your-domain.com/api/x/oauth/callback
X_REDIRECT_URI=http://localhost:3000/api/x/oauth/callback

# Where the callback bounces the user back to after connecting.
# Local:       http://localhost:5173/
# Production:  https://your-domain.com/
APP_BASE_URL=http://localhost:5173/
