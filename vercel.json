{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/x/proxy/:path*", "destination": "/api/x/proxy?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
